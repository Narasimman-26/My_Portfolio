# Backend Server URL (use your LAN IP or 10.0.2.2 for Android Emulator)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:4000

# Firebase Client Configuration (Optional if backend token exchange is used)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=securechat-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=securechat-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=securechat-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:android:abcdef
