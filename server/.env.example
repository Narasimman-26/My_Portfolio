# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8081,http://localhost:19006,exp://*

# JWT Secret Keys (Generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_production
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Firebase Admin SDK
# Provide path to service account JSON OR individual env values
FIREBASE_PROJECT_ID=securechat-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@securechat.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Optional: Path to service account file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Anthropic Claude API (for optional consented deep sensitivity check)
ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-3-5-sonnet-20241022
